# Copy to .env and edit. A single .env at the repo root feeds every app
# (see apps/api/src/core/config/env.validation.ts).
DOMAIN=example.com

NODE_ENV=development
PORT=3000

DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
DATABASE_URL=postgresql://app:change-me@localhost:5432/app

# The two secrets must differ — access and refresh token universes stay separate
# (checked at boot, the API refuses to start otherwise).
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins. Cookies are the token transport, so
# credentialed CORS needs explicit origins — empty only works when the frontend is
# same-origin (the dev proxy, or Traefik in production).
CORS_ORIGIN=http://localhost:5173

# Root of uploaded files. Empty = ./uploads at the repo root.
# In production compose overrides this with /app/uploads (a persistent volume).
# UPLOAD_DIR=
