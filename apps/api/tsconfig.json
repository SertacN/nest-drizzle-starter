{
	"compilerOptions": {
		// CommonJS, not ESM: `nest build`, the decorator metadata emit and ts-node/tsx all take
		// the well-trodden path here, and nothing in this stack needs top-level await.
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2023",
		"lib": ["ES2023"],
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": false,
		"removeComments": false,
		"sourceMap": true,
		// `incremental` is deliberately OFF. nest-cli deletes dist/ before compiling
		// (deleteOutDir), but a leftover .tsbuildinfo makes tsc believe the output is already
		// current — so the build reports success and emits NOTHING. A few saved seconds are not
		// worth a build that silently produces an empty dist.
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		// Fully strict, strictPropertyInitialization included. Every injection here is a
		// constructor parameter property, which the compiler already treats as initialised, so
		// the check costs nothing; DTO fields carry `!` because what guarantees them is
		// ValidationPipe, not the constructor.
		"strict": true,
		"types": ["node", "multer"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
